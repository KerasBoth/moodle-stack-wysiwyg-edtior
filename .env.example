# Beispielkonfiguration – als .env (bzw. .env.local) kopieren und anpassen.

# Datenbank: PostgreSQL, wenn DATABASE_URL gesetzt ist (im Docker-Compose automatisch),
# sonst eine SQLite-Datei in STACK_DATA_DIR (Standard ./data) – praktisch für die lokale Entwicklung.
# DATABASE_URL=postgres://stack:passwort@localhost:5432/stack_editor
# STACK_DATA_DIR=./data

# Nur docker-compose: Passwort des internen PostgreSQL-Benutzers. Vor dem ERSTEN Start festlegen –
# PostgreSQL übernimmt es nur beim Anlegen der Datenbank. Die Datenbank ist von außen nicht erreichbar.
# POSTGRES_PASSWORD=stack-editor

# Erstes Administratorkonto automatisch anlegen (sonst beim ersten Aufruf im Browser)
# ADMIN_USER=admin
# ADMIN_PASSWORD=bitte-aendern

# Maxima-Server (goemaxima/MaximaPool wie in STACK). Ohne Angabe rechnet die Vorschau nur lokal.
# Die Adresse endet bei goemaxima auf /goemaxima.
# MAXIMA_URL=https://your-maxima-host/goemaxima
# MAXIMA_TIMEOUT=10000
# MAXIMA_VERSION=2024012900
